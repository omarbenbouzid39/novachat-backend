# ===== إعدادات عامة =====
NODE_ENV=development
PORT=8080

# ===== قاعدة البيانات (PostgreSQL) =====
# مثال محلي عبر docker-compose المرفق:
DATABASE_URL="postgresql://novachat:novachat@localhost:5432/novachat?schema=public"
# أو استخدم Supabase/Railway/Neon/RDS في الإنتاج، مثال:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ===== JWT =====
# ولّد قيمًا عشوائية قوية (32+ حرف) قبل النشر الفعلي، مثال:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== Cloudinary (الوسائط) =====
# أنشئ حسابًا مجانيًا على cloudinary.com واحصل على القيم من Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Firebase Cloud Messaging (Push Notifications) =====
# حمّل ملف Service Account JSON من Firebase Console > Project Settings >
# Service Accounts، وضع مساره هنا (لا ترفع الملف نفسه لأي Git عام)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ===== CORS =====
# دومينات التطبيقات المسموح لها بالاتصال (افصل بينها بفاصلة)، اتركه * أثناء التطوير فقط
CORS_ALLOWED_ORIGINS=*

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ===== لوحة تحكم الإدارة (Admin Dashboard) =====
ADMIN_JWT_ACCESS_SECRET=CHANGE_ME_ADMIN_ACCESS_SECRET
ADMIN_JWT_REFRESH_SECRET=CHANGE_ME_ADMIN_REFRESH_SECRET
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# دومين لوحة التحكم Web (لضبط CORS بدقة بدل *)
ADMIN_DASHBOARD_ORIGIN=http://localhost:5173

# بيانات حساب Super Admin الأول — يُستخدم فقط عند تشغيل: npm run seed
SUPER_ADMIN_EMAIL=admin@samar.app
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPER_ADMIN_NAME=المدير العام
